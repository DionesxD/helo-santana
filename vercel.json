{
  "$schema": "https://openapi.vercel.sh/vercel/v1",
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "regions": ["gru1"],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/lembrete",
      "schedule": "0 12 * * *"
    }
  ]
}
